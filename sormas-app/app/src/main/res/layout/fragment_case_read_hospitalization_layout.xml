<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="beforeDescendants"
    android:id="@+id/base_layout">

    <data>
        <import type="de.symeda.sormas.api.utils.YesNoUnknown" />
        <import type="de.symeda.sormas.api.caze.CaseOutcome" />
        <import type="de.symeda.sormas.api.hospitalization.HospitalizationReasonType" />
        <import type="de.symeda.sormas.api.infrastructure.facility.FacilityType" />
        <import type="de.symeda.sormas.api.utils.YesNo" />
        <import type="de.symeda.sormas.app.component.controls.ControlButtonType" />
        <variable name="YesNoClass" type="Class" />

        <variable name="patientCondition" type="de.symeda.sormas.api.utils.MildModerateSevereCritical" />
        <variable name="data" type="de.symeda.sormas.app.backend.hospitalization.Hospitalization" />
        <variable name="caze" type="de.symeda.sormas.app.backend.caze.Case" />
        <variable name="previousHospitalizationList" type="androidx.databinding.ObservableList&lt;de.symeda.sormas.app.backend.hospitalization.PreviousHospitalization&gt;" />
        <variable name="previousHospitalizationBindCallback" type="de.symeda.sormas.app.util.TemplateBindingCallback" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/fragment_padding"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:id="@+id/main_content"
            >

                <TextView
                    android:id="@+id/heading_most_recent_hospitalization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/heading_case_hospitalization"
                    style="@style/SubHeadingStyle" />

                <LinearLayout
                    android:id="@+id/caseHospitalizationFacility_type_fields_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseData_healthFacility"
                        app:value="@{caze.healthFacility}"
                        style="@style/ControlFirstOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseData_healthFacilityDetails"
                        app:value="@{caze.healthFacilityDetails}"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_healthFacilityRecordNumber"
                        app:value="@{data.healthFacilityRecordNumber}"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                </LinearLayout>

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_wasPatientAdmitted"
                    app:value="@{data.wasPatientAdmitted}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_admittedToHealthFacility"
                    app:value="@{data.admittedToHealthFacility}"
                    style="@style/ControlSingleColumnStyle" />

            <de.symeda.sormas.app.component.controls.ControlTextReadField
                android:id="@+id/caseHospitalization_admittedToHealthFacilityNew"
                app:value="@{data.admittedToHealthFacilityNew}"
                style="@style/ControlSingleColumnStyle" />

                <LinearLayout
                    android:id="@+id/caseHospitalization_memberFamilyHelpingPatient_deathDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_memberFamilyHelpingPatient"
                        app:value="@{data.memberFamilyHelpingPatient}"
                        style="@style/ControlSingleColumnStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_dateOfDeath"
                        app:value="@{data.dateOfDeath}"
                        style="@style/ControlSingleColumnStyle" />

                </LinearLayout>

            <de.symeda.sormas.app.component.controls.ControlTextReadField
                android:id="@+id/caseHospitalization_hospitalRecordNumber"
                app:value="@{data.hospitalRecordNumber}"
                style="@style/ControlSingleColumnStyle" />

            <LinearLayout
                    android:id="@+id/caseHospitalization_admission_discharge_Date_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_admissionDate"
                        app:value="@{data.admissionDate}"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_dischargeDate"
                        app:value="@{data.dischargeDate}"
                        app:allowedDaysInFuture="7"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                </LinearLayout>

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_terminationDateHospitalStay"
                    app:value="@{data.terminationDateHospitalStay}"
                    style="@style/ControlSingleColumnStyle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/outcome_layout">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseData_Outcome"
                        dependencyParentField="@{caseHospitalizationDischargeDate}"
                        app:dependencyParentVisibility="@{false}"
                        app:value="@{caze.outcome}"
                        style="@style/ControlFirstOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseData_specifyOtherOutcome"
                        style="@style/ControlSecondOfTwoColumnsStyle"
                        app:dependencyParentField="@{caseDataOutcome}"
                        app:dependencyParentValue="@{CaseOutcome.OTHER}"
                        app:dependencyParentVisibility="@{true}"
                        app:required="false"
                        app:softRequired="true"
                        app:value="@{caze.specifyOtherOutcome}" />
                </LinearLayout>

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_intensiveCareUnit"
                    app:value="@{data.intensiveCareUnit}"
                    style="@style/ControlSingleColumnStyle" />

                <LinearLayout
                    android:id="@+id/caseHospitalization_intensiveCareUnitStartEndLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_intensiveCareUnitStart"
                        dependencyParentField="@{caseHospitalizationIntensiveCareUnit}"
                        dependencyParentValue="@{YesNo.YES}"
                        app:value="@{data.intensiveCareUnitStart}"
                        style="@style/ControlFirstOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_intensiveCareUnitEnd"
                        dependencyParentField="@{caseHospitalizationIntensiveCareUnit}"
                        dependencyParentValue="@{YesNo.YES}"
                        app:value="@{data.intensiveCareUnitEnd}"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                </LinearLayout>

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_leftAgainstAdvice"
                    app:value="@{data.leftAgainstAdvice}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_patientConditionOnAdmission"
                    style="@style/ControlSingleColumnStyle"
                    app:value="@{data.patientConditionOnAdmission}" />

                <!--                <de.symeda.sormas.app.component.controls.ControlTextReadField-->
                <!--                    android:id="@+id/caseHospitalization_patientConditionOnAdmission"-->
                <!--                    app:required="false"-->
                <!--                    app:value="@{data.caseHospitalization_patientConditionOnAdmission}"-->
                <!--                    app:softRequired="true"-->
                <!--                    app:dependencyParentVisibility="@{true}"-->
                <!--                    app:userEditRight="@{UserRight.CASE_CLASSIFY}"-->
                <!--                    style="@style/ControlSecondOfTwoColumnsStyle" />-->

                <LinearLayout
                    android:id="@+id/caseHospitalization_isolated_and_date_heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_isolated"
                        app:useAbbreviations="true"
                        app:value="@{data.isolated}"
                        style="@style/ControlFirstOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_isolationDate"
                        dependencyParentField="@{caseHospitalizationIsolated}"
                        dependencyParentValue="@{YesNo.YES}"
                        app:value="@{data.isolationDate}"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                </LinearLayout>

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_patientVentilated"
                    app:value="@{data.patientVentilated}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_description"
                    style="@style/ControlSingleColumnStyle"
                    app:value="@{data.description}" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_hospitalizationReason"
                    app:value="@{data.hospitalizationReason}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_otherHospitalizationReason"
                    app:value="@{data.otherHospitalizationReason}"
                    app:dependencyParentField="@{caseHospitalizationHospitalizationReason}"
                    app:dependencyParentValue="@{HospitalizationReasonType.OTHER}"
                    style="@style/ControlSingleColumnStyle" />

                <LinearLayout
                    android:id="@+id/caseHospitalization_notifyDistrictFormSentToDistrictDate_Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/fragment_padding">

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_notifyDistrictDate"
                        app:value="@{data.notifyDistrictDate}"
                        style="@style/ControlFirstOfTwoColumnsStyle" />

                    <de.symeda.sormas.app.component.controls.ControlTextReadField
                        android:id="@+id/caseHospitalization_dateFormSentToDistrict"
                        app:value="@{data.dateFormSentToDistrict}"
                        style="@style/ControlSecondOfTwoColumnsStyle" />

                </LinearLayout>

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_hospitalizedPreviously"
                    app:value="@{data.hospitalizedPreviously}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_diseaseOnsetDate"
                    app:value="@{data.diseaseOnsetDate}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_selectInpatientOutpatient"
                    app:value="@{data.selectInpatientOutpatient}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_dateFirstSeen"
                    app:value="@{data.dateFirstSeen}"
                    style="@style/ControlSingleColumnStyle" />

                <de.symeda.sormas.app.component.controls.ControlTextReadField
                    android:id="@+id/caseHospitalization_seenAtAHealthFacility"
                    app:value="@{data.seenAtAHealthFacility}"
                    style="@style/ControlSingleColumnStyle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/heading_previous_hospitalizations"
                android:layout_marginBottom="@dimen/subHeadlineMarginBottom"
                style="@style/SubHeadingCompactStyle" />

            <LinearLayout
                android:id="@+id/list_previous_hospitalizations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:padding="@dimen/rowListItemParentElevationVerticalPadding"
                app:entries="@{previousHospitalizationList}"
                app:layout="@{@layout/row_case_previous_hospitalization_layout}"
                app:bindCallback="@{previousHospitalizationBindCallback}" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</layout>

